# --- LLM (Claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_MAX_TOKENS=16000
# Server-side refusal fallback (beta)
LLM_FALLBACKS=true

# --- Agent ---
MAX_ITERATIONS=10
SAVE_TO_LONG_TERM=true
# Read "Security model" in the README before enabling
ENABLE_CODE_EXECUTOR=false
# Pause for a human decision before file writes / code execution
REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_SECONDS=300

# --- API ---
# Set to require an X-API-Key header on every request (leave empty to disable)
API_KEY=
CORS_ORIGINS=["http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=20
API_PORT=8000

# --- Storage (for local runs; docker-compose overrides both URLs) ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://agent:change-me@localhost:5432/agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent
